<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tir_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_tir_today"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Segmented colour bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/tir_vl_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.01"
            android:background="#D50000" />

        <View
            android:id="@+id/tir_l_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.04"
            android:background="#FF6D00" />

        <View
            android:id="@+id/tir_tr_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.75"
            android:background="#00C853" />

        <View
            android:id="@+id/tir_h_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.15"
            android:background="#FFD600" />

        <View
            android:id="@+id/tir_vh_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.05"
            android:background="#D50000" />
    </LinearLayout>

    <!-- Percentage labels below bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/tir_vl_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="#D50000"
            android:gravity="start"
            android:text="" />

        <TextView
            android:id="@+id/tir_l_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="#FF6D00"
            android:gravity="start"
            android:text="" />

        <TextView
            android:id="@+id/tir_tr_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="9sp"
            android:textColor="#00C853"
            android:gravity="center"
            android:text="" />

        <TextView
            android:id="@+id/tir_h_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="#FFD600"
            android:gravity="end"
            android:text="" />

        <TextView
            android:id="@+id/tir_vh_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="9sp"
            android:textColor="#D50000"
            android:gravity="end"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/tir_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="9sp"
        android:text="@string/dashboard_tir_stats_placeholder" />

</LinearLayout>
