<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dashboard_card_surface"
        android:orientation="vertical"
        android:padding="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Ring: fixed size and centered to PARENT so columns cannot shrink it -->
            <app.aaps.core.ui.views.GlucoseRingView
                android:id="@+id/glucose_ring"
                style="@style/GlucoseRingViewStepped"
                android:layout_width="149dp"
                android:layout_height="149dp"
                android:elevation="3dp"
                app:ringStrokeWidth="5dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottom_action_row"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" 
                app:layout_constraintVertical_chainStyle="packed" />

            <!-- Left column-->
            <LinearLayout
                android:id="@+id/left_col"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="@id/glucose_ring"
                app:layout_constraintBottom_toBottomOf="@id/glucose_ring"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/glucose_ring"
                app:layout_constrainedWidth="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_cp_age_insulin"
                        app:tint="@color/dashboard_on_surface" />

                    <TextView
                        android:id="@+id/reservoir_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/dashboard_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_cp_age_cannula"
                        app:tint="@color/dashboard_on_surface" />

                    <TextView
                        android:id="@+id/infusion_age_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/dashboard_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_dashboard_battery"
                        app:tint="@color/dashboard_on_surface" />

                    <TextView
                        android:id="@+id/pump_battery_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/dashboard_on_surface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_cp_age_sensor"
                        app:tint="@color/dashboard_on_surface" />

                    <TextView
                        android:id="@+id/sensor_age_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/dashboard_on_surface" />
                </LinearLayout>

            </LinearLayout>

            <!-- RIGHT COLUMN: 4 rows -->
            <LinearLayout
                android:id="@+id/right_col"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:gravity="center_vertical|end"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/glucose_ring"
                app:layout_constraintBottom_toBottomOf="@id/glucose_ring"
                app:layout_constraintStart_toEndOf="@id/glucose_ring"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constrainedWidth="true">

                <!-- Top right: last update + last sensor value (keeps space for AIMI overlay) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_dashboard_droplet"
                        app:tint="@color/dashboard_on_surface" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/last_update_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                            android:textColor="@color/dashboard_on_surface" />

                        <TextView
                            android:id="@+id/last_sensor_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                            android:textColor="@color/dashboard_on_surface" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:baselineAligned="false"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_dashboard_wave"
                        app:tint="@color/dashboard_on_surface" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                       <TextView
                           android:id="@+id/activity_text"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:includeFontPadding="false"
                           android:maxLines="1"
                           android:singleLine="true"
                           android:ellipsize="end"
                           android:text="--"
                           android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                           android:textColor="@color/dashboard_on_surface" />


                       <TextView
                           android:id="@+id/basal_text"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:includeFontPadding="false"
                           android:maxLines="1"
                           android:singleLine="true"
                           android:ellipsize="end"
                           android:text="--"
                           android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                           android:textColor="@color/dashboard_on_surface" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_dashboard_iob"
                        app:tint="@color/dashboard_on_surface" />

                    <TextView
                        android:id="@+id/iob_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                        android:textColor="@color/dashboard_on_surface" />
                </LinearLayout>

            </LinearLayout>

            <!-- Bottom action chips -->
            <LinearLayout
                android:id="@+id/bottom_action_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="6"
                app:layout_constraintTop_toBottomOf="@id/glucose_ring"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_aimi_advisor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"

                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"

                    android:text="@string/circle_btn_aimi_advisor"
                    android:gravity="center"
                    android:textAlignment="center"

                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"

                    app:chipStartPadding="1dp"
                    app:chipEndPadding="1dp"
                    app:textStartPadding="1dp"
                    app:textEndPadding="1dp"
                    
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipBackgroundColor="@color/dashboard_chip_background"
                    app:chipStrokeWidth="1.5dp"
                    app:chipStrokeColor="@color/dashboard_chip_border"
                    app:chipMinHeight="32dp"
                    app:chipCornerRadius="12dp"
                    android:textColor="@color/dashboard_on_surface"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    
                    app:chipIconVisible="false"
                    app:closeIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_adjust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"

                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"

                    android:text="@string/circle_btn_adjust"
                    android:gravity="center"
                    android:textAlignment="center"

                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"

                    app:chipStartPadding="1dp"
                    app:chipEndPadding="1dp"
                    app:textStartPadding="1dp"
                    app:textEndPadding="1dp"
                    
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipBackgroundColor="@color/dashboard_chip_background"
                    app:chipStrokeWidth="1.5dp"
                    app:chipStrokeColor="@color/dashboard_chip_border"
                    app:chipMinHeight="32dp"
                    app:chipCornerRadius="12dp"
                    android:textColor="@color/dashboard_on_surface"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    
                    app:chipIconVisible="false"
                    app:closeIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_context"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"

                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"

                    android:text="@string/circle_btn_context"
                    android:gravity="center"
                    android:textAlignment="center"

                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"

                    app:chipStartPadding="1dp"
                    app:chipEndPadding="1dp"
                    app:textStartPadding="1dp"
                    app:textEndPadding="1dp"
                    
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipBackgroundColor="@color/dashboard_chip_background"
                    app:chipStrokeWidth="1.5dp"
                    app:chipStrokeColor="@color/dashboard_chip_border"
                    app:chipMinHeight="32dp"
                    app:chipCornerRadius="12dp"
                    android:textColor="@color/dashboard_on_surface"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    
                    app:chipIconVisible="false"
                    app:closeIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_food"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"

                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"

                    android:text="@string/circle_btn_food"
                    android:gravity="center"
                    android:textAlignment="center"

                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"

                    app:chipStartPadding="1dp"
                    app:chipEndPadding="1dp"
                    app:textStartPadding="1dp"
                    app:textEndPadding="1dp"
                    
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipBackgroundColor="@color/dashboard_chip_background"
                    app:chipStrokeWidth="1.5dp"
                    app:chipStrokeColor="@color/dashboard_chip_border"
                    app:chipMinHeight="32dp"
                    app:chipCornerRadius="12dp"
                    android:textColor="@color/dashboard_on_surface"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    
                    app:chipIconVisible="false"
                    app:closeIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_aimi_pref"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"

                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"

                    android:text="@string/circle_btn_aimi_pref"
                    android:gravity="center"
                    android:textAlignment="center"

                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"

                    app:chipStartPadding="1dp"
                    app:chipEndPadding="1dp"
                    app:textStartPadding="1dp"
                    app:textEndPadding="1dp"
                    
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipBackgroundColor="@color/dashboard_chip_background"
                    app:chipStrokeWidth="1.5dp"
                    app:chipStrokeColor="@color/dashboard_chip_border"
                    app:chipMinHeight="32dp"
                    app:chipCornerRadius="12dp"
                    android:textColor="@color/dashboard_on_surface"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    
                    app:chipIconVisible="false"
                    app:closeIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"

                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"

                    android:text="@string/circle_btn_stats"
                    android:gravity="center"
                    android:textAlignment="center"

                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="8sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"

                    app:chipStartPadding="1dp"
                    app:chipEndPadding="1dp"
                    app:textStartPadding="1dp"
                    app:textEndPadding="1dp"
                    
                    android:elevation="4dp"
                    android:minWidth="0dp"
                    app:chipMinTouchTargetSize="0dp"
                    app:chipBackgroundColor="@color/dashboard_chip_background"
                    app:chipStrokeWidth="1.5dp"
                    app:chipStrokeColor="@color/dashboard_chip_border"
                    app:chipMinHeight="32dp"
                    app:chipCornerRadius="12dp"
                    android:textColor="@color/dashboard_on_surface"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    
                    app:chipIconVisible="false"
                    app:closeIconVisible="false" />
                    
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</merge>
