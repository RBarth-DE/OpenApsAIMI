<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dashboard_chip_background_pressed"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Activated / Active -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dashboard_chip_background_active"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dashboard_chip_background"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>

