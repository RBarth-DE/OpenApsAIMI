  "feature_groups": {
    "isf_weights": {
      "id": "isf_weights",
      "name": "AutoISF Weights",
      "description": "Core AutoISF weight system. Six weights control how different signals contribute to ISF adjustment: bgAccel (rising BG), bgBrake (falling BG), lowBg (hypo risk), highBg (hyper), pp (post-prandial), dura (duration). Weights are clamped by ApsAutoIsfMin/ApsAutoIsfMax and bounded by IobThPercent (IOB threshold % of basal).",
      "gate_key": "openapsama_use_autoisf_weights",
      "param_count": 5,
      "key_params": [
        "autoISF_max",
        "autoISF_min",
        "dura_ISF_weight",
        "iob_threshold_percent",
        "pp_ISF_weight"
      ]
    },
    "smb_delivery": {
      "id": "smb_delivery",
      "name": "SMB Delivery Ratio",
      "description": "Dynamic SMB delivery ratio that scales SMB size based on BG position. Ratio/slope with min/max bounds, BG range definition, and max range extension. SmbOnEvenTarget allows delivery even when BG equals target (no delta signal).",
      "gate_key": "openapsama_use_smb",
      "param_count": 5,
      "key_params": [
        "openapsama_smb_delivery_ratio",
        "openapsama_smb_delivery_ratio_bg_range",
        "openapsama_smb_delivery_ratio_max",
        "openapsama_smb_delivery_ratio_min",
        "openapsama_smb_max_range_extension"
      ]
    },
    "temp_target_interaction": {
      "id": "temp_target_interaction",
      "name": "Temp Target Interaction",
      "description": "How AutoISF interacts with temp targets. HighTtRaisesSens: high temp target → raise sensitivity (less insulin). LowTtLowersSens: low temp target → lower sensitivity (more insulin). HalfBasalExerciseTarget defines the BG for half-basal during exercise.",
      "gate_key": null,
      "param_count": 1,
      "key_params": [
        "half_basal_exercise_target"
      ]
    },
    "shared_aaps": {
      "id": "shared_aaps",
      "name": "Shared AAPS Settings",
      "description": "Standard OpenAPS settings that AutoISF also reads: max basal, max IOB, SMB gates, autosens, sensitivity/target interactions.",
      "gate_key": null,
      "param_count": 28,
      "key_params": [
        "Enable alternative activation of SMB always",
        "always_use_shortavg",
        "autosens_adjust_targets",
        "autosens_max",
        "autosens_min",
        "bgAccel_ISF_weight",
        "bgBrake_ISF_weight",
        "carbsReqThreshold",
        "enableSMB_after_carbs",
        "enableSMB_always",
        "enableSMB_with_COB",
        "enableSMB_with_high_temptarget",
        "enableSMB_with_temptarget",
        "high_temptarget_raises_sensitivity",
        "higher_ISFrange_weight"
      ]
    }
  }
